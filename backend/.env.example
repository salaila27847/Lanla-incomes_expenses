# Get a key at https://opentyphoon.ai: sign up, then Playground > API Keys
# (free research showcase, no billing account needed). Leave
# OCR_MOCK_MODE=true until you have one.
TYPHOON_API_KEY=
TYPHOON_BASE_URL=https://api.opentyphoon.ai/v1
TYPHOON_OCR_MODEL=typhoon-ocr

# When true, /ocr returns a canned fixture instead of calling Typhoon —
# on by default since no real receipt photos or API key exist yet.
OCR_MOCK_MODE=true

# rapidfuzz score (0-100) below which /match reports matched=false instead
# of guessing.
MATCH_CONFIDENCE_THRESHOLD=60

# Shared secret the /controller service sends on every request, so this
# backend can reject calls that didn't come from it.
CONTROLLER_SHARED_SECRET=changeme

# The savings account's PromptPay-linked ID: a 10-digit phone number,
# 13-digit national/tax ID, or 15-digit e-wallet ID — check your banking
# app's PromptPay settings for whichever one is linked. Required for
# /qr to work; there's no mock mode for this (no external service to
# mock, it's pure computation), so QR generation 400s until this is set.
SAVINGS_PROMPTPAY_ID=
