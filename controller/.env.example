# Service-account key with access to the target Google Sheet (share the
# sheet with this service account's email after creating it). See
# SETUP.md for the full one-time checklist.
#
# Local dev: a path to the downloaded key file.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./gcp-sheets-service-account.json
# Deploying (e.g. Vercel): set this instead — the key file's raw JSON
# contents, pasted as one env var. Takes priority over the path above
# when both are set. See DEPLOY.md.
GOOGLE_SERVICE_ACCOUNT_KEY_JSON=
SHEETS_SPREADSHEET_ID=

# When true, the Sheets client uses an in-memory list instead of a real
# Sheet — on by default since no Sheet/service account exists yet.
SHEETS_MOCK_MODE=true

# Where the Python OCR/matching/QR backend is running.
PYTHON_BACKEND_URL=http://localhost:8000

PORT=3001
